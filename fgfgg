--================= СКРЫТИЕ ПО БИНДУ (FIX: снимок каждый раз + resync) =================
local hidden = false
local hiding = false
local FADE_DUR = 0.25
local function captureFade(rootObj)
	local t = {}
	local function g(o)
		local r = {}
		if o:IsA("GuiObject") then r.bg = o.BackgroundTransparency end
		if o:IsA("TextLabel") or o:IsA("TextBox") or o:IsA("TextButton") then r.tx = o.TextTransparency end
		if o:IsA("ImageLabel") or o:IsA("ImageButton") then r.im = o.ImageTransparency end
		if o:IsA("UIStroke") then r.st = o.Transparency end
		if o:IsA("CanvasGroup") then r.gt = o.GroupTransparency end
		t[o] = r
	end
	g(rootObj)
	for _, d in ipairs(rootObj:GetDescendants()) do
		g(d)
	end
	return t
end
local fadeBase = nil
local function resyncVisibility()
	if currentGroup then
		currentGroup.Visible = true
		currentGroup.GroupTransparency = 0
	end
	for _, lp in ipairs(listPages) do
		if lp.detailOpen and lp.detail then
			lp.detail.Visible = true
			lp.detail.GroupTransparency = 0
		end
		if lp.applyPanelsVisibility then
			lp.applyPanelsVisibility()
		end
	end
end
local function fadeGui(hide)
	if hiding then
		return
	end
	hiding = true
	if hide then
		-- снимаем снимок КАЖДЫЙ раз перед скрытием: восстанавливать будем именно то, что было видно
		fadeBase = captureFade(win)
	else
		gui.Enabled = true
		win.Visible = true
	end
	for o, b in pairs(fadeBase or {}) do
		local p = {}
		if hide then
			if b.bg then p.BackgroundTransparency = 1 end
			if b.tx then p.TextTransparency = 1 end
			if b.im then p.ImageTransparency = 1 end
			if b.st then p.Transparency = 1 end
			if b.gt then p.GroupTransparency = 1 end
		else
			if b.bg then p.BackgroundTransparency = b.bg end
			if b.tx then p.TextTransparency = b.tx end
			if b.im then p.ImageTransparency = b.im end
			if b.st then p.Transparency = b.st end
			if b.gt then p.GroupTransparency = b.gt end
		end
		if next(p) then
			pcall(function() tween(o, FADE_DUR, p) end)
		end
	end
	task.delay(FADE_DUR + 0.05, function()
		if hide then
			win.Visible = false
		else
			resyncVisibility()
		end
		hiding = false
	end)
end
toggleHide = function()
	hidden = not hidden
	fadeGui(hidden)
	if mobileOrb then
		mobileOrb.Visible = hidden
	end
end
local function resetPos()
	tween(win, 0.25, {Position = UDim2.fromScale(.5, .5)})
end

