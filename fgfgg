--================= SPRING =================
local Spring = {}
Spring.__index = Spring
function Spring.new(v,k,d)
	return setmetatable({value=v,target=v,velocity=0,stiffness=k or 260,damping=d or 18},Spring)
end
function Spring:step(dt)
	local a = (self.target-self.value)*self.stiffness - self.velocity*self.damping
	self.velocity = self.velocity + a*dt
	self.value = self.value + self.velocity*dt
	return self.value
end

