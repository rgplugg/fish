local function selectPage(i)
	if i==currentIndex then
		return
	end
	local dir = (i>currentIndex) and 1 or -1
	currentIndex = i
	navSpring.target = NAV_Y+(i-1)*(NAV_H+NAV_GAP)
	for j,it in ipairs(navItems) do
		tween(it.lbl,.2,{TextColor3=(j==i) and WHITE or GRAY})
	end
	local kind = navDefs[i][2]
	headerTitle.Text = navDefs[i][1]
	headerSub.Text = PAGE_SUBS[kind]
	headerIcon.Image = ICONS[PAGE_ICON[kind]] or ""
	searchBox.Visible = kind~="about"
	reloadBtn.Visible = kind~="about"
	searchInput.PlaceholderText = kind=="settings" and "Search settings..." or (kind=="emotes" and "Search emote..." or "Search effect...")
	if pages[i].closeDrop then
		pages[i].closeDrop()
	end
	for _,lp in ipairs(listPages) do
		hidePreview(lp)
	end
	local old = currentGroup
	local new = pages[i].group
	if old and old~=new then
		local t = tween(old,.18,{GroupTransparency=1})
		t.Completed:Connect(function()
			if old~=currentGroup then
				old.Visible=false
			end
		end)
	end
	new.Visible=true
	new.GroupTransparency=1
	tween(new,.25,{GroupTransparency=0})
	pageSpring.value=60*dir
	pageSpring.velocity=0
	pageSpring.target=0
	currentGroup=new
end
for i,it in ipairs(navItems) do
	it.btn.MouseButton1Click:Connect(function()
		selectPage(i)
	end)
end

