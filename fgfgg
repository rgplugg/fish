function showPreview(pg,side,name)
	local pv = pg.preview
	pv.dir = side=="right" and 1 or -1
	pv.baseX = side=="right" and (PAD+PANEL_W+16) or PAD
	pv.spring.value = pv.dir*110
	pv.spring.velocity = 0
	pv.spring.target = 0
	pv.nameLbl.Text = name
	local asset = ensureIcon(name)
	if asset and asset ~= "" then
		pv.img.Image = asset
		pv.img.Visible = true
		if pv.bgImg then
			pv.bgImg.Image = asset
		end
		if pv.glyph then
			pv.glyph.Visible = false
		end
	else
		pv.img.Image = ""
		pv.img.Visible = false
		if pv.bgImg then
			pv.bgImg.Image = ""
		end
		if pv.glyph then
			pv.glyph.Text = (name:sub(1,1) or "?"):upper()
			pv.glyph.Visible = true
		end
	end
	pv.card.Position = UDim2.fromOffset(pv.baseX+pv.spring.value,40)
	pv.card.Visible = true
	pv.token = pv.token+1
	tween(pv.card,.2,{GroupTransparency=0})
end
function hidePreview(pg)
	local pv = pg.preview
	pv.token = pv.token+1
	local t = pv.token
	pv.spring.target = pv.dir*70
	local tw = tween(pv.card,.18,{GroupTransparency=1})
	tw.Completed:Connect(function()
		if pv.token==t then
			pv.card.Visible=false
		end
	end)
end
