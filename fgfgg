local PREVIEW_IMAGES = {}
local function getIconFromRS(name)
	if PREVIEW_IMAGES[name] then
		return PREVIEW_IMAGES[name]
	end
	local items = RS:FindFirstChild("Items")
	if not items then
		return nil
	end
	local found = nil
	local function searchForIcon(folder, depth)
		if depth > 15 or not folder or found then
			return
		end
		for _, ch in ipairs(folder:GetChildren()) do
			if found then
				return
			end
			if ch.Name == name and ch:IsA("ModuleScript") then
				local ok, data = pcall(function() return require(ch) end)
				if ok and type(data) == "table" and data.AppearanceInfo then
					local iconId = data.AppearanceInfo.Icon
					if type(iconId) == "number" and iconId > 0 then
						found = "rbxassetid://" .. iconId
					end
				end
			elseif ch:IsA("Folder") then
				searchForIcon(ch, depth + 1)
			end
		end
	end
	searchForIcon(items, 0)
	if found then
		PREVIEW_IMAGES[name] = found
		return found
	end
	return nil
end
local function ensureIcon(name)
	if PREVIEW_IMAGES[name] then
		return PREVIEW_IMAGES[name]
	end
	return getIconFromRS(name)
end

