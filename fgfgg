local snapRoot = Instance.new("Folder")
snapRoot.Name = "_rg__snap"
snapRoot.Parent = RS
local eSnaps, eRefs, lSnaps, bSnaps, bRefs, effSnaps, effRefs, seenSnap = {}, {}, {}, {}, {}, {}, {}, {}
local function nav(root, path)
	local c = root
	for p in path:gmatch("([^%.]+)") do
		c = c and c:FindFirstChild(p)
	end
	return c
end
local itemNameCache = nil
local function buildNameCache()
	if itemNameCache then
		return itemNameCache
	end
	itemNameCache = {}
	local items = RS:FindFirstChild("Items")
	if not items then
		return itemNameCache
	end
	local stack = {items}
	local count = 0
	while #stack > 0 do
		local node = table.remove(stack)
		for _, ch in ipairs(node:GetChildren()) do
			count = count + 1
			if count % 400 == 0 then
				task.wait()
			end
			if not itemNameCache[ch.Name] then
				itemNameCache[ch.Name] = ch
			end
			if ch:IsA("Folder") then
				table.insert(stack, ch)
			end
		end
	end
	return itemNameCache
end
local function findDeep(folder, name, depth)
	depth = depth or 0
	if depth > 6 then
		return nil
	end
	local d = folder:FindFirstChild(name)
	if d then
		return d
	end
	for _, ch in ipairs(folder:GetChildren()) do
		if ch:IsA("Folder") then
			local f = findDeep(ch, name, depth + 1)
			if f then
				return f
			end
		end
	end
	return nil
end
local function findInItems(targetFolder, itemName)
	local items = RS:FindFirstChild("Items")
	if not items then
		return nil
	end
	local function search(folder, depth)
		if depth > 10 then
			return nil
		end
		for _, ch in ipairs(folder:GetChildren()) do
			if ch.Name == targetFolder then
				local f = findDeep(ch, itemName)
				if f then
					return f
				end
			elseif ch:IsA("Folder") then
				local f = search(ch, depth + 1)
				if f then
					return f
				end
			end
		end
		return nil
	end
	return search(items, 0)
end
local function findAnywhere(itemName)
	local items = RS:FindFirstChild("Items")
	if not items then
		return nil
	end
	return findDeep(items, itemName)
end
local function resolveAny(path)
	local o = nav(RS, path)
	if o then
		return o
	end
	local name = path:match("([^%.]+)$")
	if not name then
		return nil
	end
	if itemNameCache and itemNameCache[name] then
		return itemNameCache[name]
	end
	return findInItems("Emotes", name) or findInItems("Cosmetics", name) or findAnywhere(name)
end
swapContent = function(tgtPath, srcPath)
	local t = resolveAny(tgtPath)
	local s = resolveAny(srcPath)
	if not t or not s then
		return false
	end
	for _, c in pairs(t:GetChildren()) do
		c:Destroy()
	end
	for _, c in pairs(s:GetChildren()) do
		c:Clone().Parent = t
	end
	return true
end
swapLegacy = function(tgtPath, srcPath)
	local t = resolveAny(tgtPath)
	local s = resolveAny(srcPath)
	if not t or not s then
		return false
	end
	for _, key in ipairs({"Visual", "Animation"}) do
		local srcC = s:FindFirstChild(key)
		if srcC then
			pcall(function()
				local old = t:FindFirstChild(key)
				if old then
					old:Destroy()
				end
				srcC:Clone().Parent = t
			end)
		end
	end
	return true
end
resetEmotes = function()
	for path, snap in pairs(lSnaps) do
		local i = nav(RS, path)
		if i then
			for _, key in ipairs({"Visual", "Animation"}) do
				local old = i:FindFirstChild(key)
				if old then
					pcall(function() old:Destroy() end)
				end
				local s = snap:FindFirstChild(key)
				if s then
					s:Clone().Parent = i
				end
			end
		end
	end
end
resetBase = function(p)
	local inst = nav(RS, p)
	local snap = bSnaps[p]
	if inst and snap then
		for _, c in pairs(inst:GetChildren()) do
			c:Destroy()
		end
		for _, c in pairs(snap:GetChildren()) do
			c:Clone().Parent = inst
		end
		return true
	end
	return false
end
