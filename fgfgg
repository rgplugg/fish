		return
	end
	local baseName = basePath:match("([^%.]+)$")
	local effObj = resolveAny("Items.Cosmetics." .. effPath:match("[^%.]+$"))
	if not effObj then
		return
	end
	local charCos = char:FindFirstChild(baseName, true)
	if charCos then
		for _, c in pairs(charCos:GetChildren()) do
			pcall(function() c:Destroy() end)
		end
		for _, c in pairs(effObj:GetChildren()) do
			pcall(function() c:Clone().Parent = charCos end)
		end
	end
end
