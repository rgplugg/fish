local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)
local function spaceMacro(hum)
	if isMobile then
		if hum then
			hum.Jump = true
		end
		return true
	end
	if not VIM then
		return false
	end
	local ok = pcall(function()
		VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
		VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	end)
	return ok
end
spaceRelease = function()
	if isMobile then
		return
	end
	if not VIM then
		return
	end
	pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
end
local function forceJump(hum)
	pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
	pcall(function()
		if hum.UseJumpPower then
			if hum.JumpPower <= 0 then
				hum.JumpPower = 50
			end
		elseif hum.JumpHeight <= 0 then
			hum.JumpHeight = 7.2
		end
	end)
	hum.Jump = true
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
end
local bhopSpamming = false
local bhopConn = RunService.Heartbeat:Connect(function()
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		if bhopSpamming then
			bhopSpamming = false
			spaceRelease()
		end
		return
	end
	local busy = Keys.listening ~= nil or UIS:GetFocusedTextBox() ~= nil
	local spam = false
	local forced = false
	if not busy then
		if bhopMode == "Macro BHOP" then
			spam = vHeld
		elseif bhopMode == "Always On" then
			spam = not bhopPaused
		elseif bhopMode == "Hold Unlimited Speed" then
			forced = spaceHeld and not bhopPaused
		elseif bhopMode == "Alw Unlimited Speed" then
			forced = not bhopPaused
		end
	end
	if spam then
		bhopSpamming = true
		if isMobile then
			if hum.FloorMaterial ~= Enum.Material.Air then
				forceJump(hum)
			end
		else
			if not spaceMacro(hum) then
				hum.Jump = true
			end
		end
	elseif bhopSpamming then
		bhopSpamming = false
		spaceRelease()
	end
	if forced and hum.FloorMaterial ~= Enum.Material.Air then
		forceJump(hum)
	end
end)

