UIS.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if input.KeyCode == Enum.KeyCode.Space then
		if UIS:GetFocusedTextBox() then
			return
		end
		spaceHeld = true
		return
	end
	if Keys.listening then
		return
	end
	if UIS:GetFocusedTextBox() then
		return
	end
	if matches("bhop", input.KeyCode) then
		if bhopMode == "Macro BHOP" then
			vHeld = true
		else
			bhopPaused = not bhopPaused
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if input.KeyCode == Enum.KeyCode.Space then
		spaceHeld = false
		return
	end
	local kb = Keys.bhop or "V"
	local plus = kb:find(" + ",1,true)
	local mainKey = plus and kb:sub(plus+3) or kb
	if input.KeyCode.Name == mainKey then
		vHeld = false
	end
end)
