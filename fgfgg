local Keys = {hide="LeftControl", reset="R", bhop="V", listening=nil, modifier=nil, labels={}, rings={}, lastFinalize=nil, lastFinalizeAt=0}
local DISP = {LeftControl="LCTRL",RightControl="RCTRL",LeftAlt="LALT",RightAlt="RALT",LeftShift="LSHIFT",RightShift="RSHIFT",LeftSuper="LWIN",RightSuper="RWIN",PageUp="PGUP",PageDown="PGDN",Insert="INS",Delete="DEL",Home="HOME",End="END",Escape="ESC",Space="SPACE",Backspace="BKSP",Tab="TAB",CapsLock="CAPS",Return="ENTER"}
local MODS = {LeftControl=true,RightControl=true,LeftAlt=true,RightAlt=true,LeftShift=true,RightShift=true,LeftSuper=true,RightSuper=true,Home=true,End=true,PageUp=true,PageDown=true,Insert=true,Delete=true}
local function disp(kb)
	if not kb or kb=="" or kb=="NONE" then
		return "NONE"
	end
	local plus = kb:find(" + ",1,true)
	if plus then
		local a,b = kb:sub(1,plus-1), kb:sub(plus+3)
		return (DISP[a] or a).." + "..(DISP[b] or b)
	end
	return DISP[kb] or kb
end
local function paintRing(a)
	local r = Keys.rings[a]
	if r then
		tween(r,.18,{Transparency = Keys.listening==a and .55 or 1})
	end
end
local function setKey(a,v)
	Keys[a]=v
	if Keys.labels[a] then
		Keys.labels[a].Text = disp(v)
	end
end
local function stopListen()
	local a = Keys.listening
	Keys.listening, Keys.modifier = nil, nil
	if a then
		paintRing(a)
	end
end
local function startListen(a)
	local prev = Keys.listening
	Keys.listening, Keys.modifier = a, nil
	if prev and prev~=a then
		paintRing(prev)
	end
	paintRing(a)
	if Keys.labels[a] then
		Keys.labels[a].Text = "..."
	end
end
local function handleKey(kc)
	local name = kc.Name
	if MODS[name] then
		Keys.modifier = name
		if Keys.labels[Keys.listening] then
			Keys.labels[Keys.listening].Text = (DISP[name] or name).." + ..."
		end
		return
	end
	local a = Keys.listening
	local v = Keys.modifier and (Keys.modifier.." + "..name) or name
	stopListen()
	Keys.lastFinalize, Keys.lastFinalizeAt = nil, 0
	setKey(a,v)
end
local function mouseCancel()
	if not Keys.listening then
		return
	end
	local a,m = Keys.listening, Keys.modifier
	stopListen()
	Keys.lastFinalize, Keys.lastFinalizeAt = a, os.clock()
	setKey(a, m or "NONE")
end
local function matches(a,kc)
	local kb = Keys[a]
	if not kb or kb=="NONE" then
		return false
	end
	local plus = kb:find(" + ",1,true)
	if plus then
		local mod,key = kb:sub(1,plus-1), kb:sub(plus+3)
		if kc.Name ~= key then
			return false
		end
		local ok,e = pcall(function() return Enum.KeyCode[mod] end)
		return ok and e~=nil and UIS:IsKeyDown(e)
	end
	return kc.Name == kb
end

