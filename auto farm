globalKeyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if activeBinding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local target = activeBinding
        activeBinding = nil
        if target == "hidegui" then
            SETTINGS.HIDE_KEYBIND = nil
            if keybindButton then keybindButton.Text = "None" end
        else
            KeyBinds[target] = nil
            if kbChips[target] then kbChips[target].update() end
        end
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if gameProcessed then return end
    local key = input.KeyCode
    if activeBinding then
        local target = activeBinding
        if key == Enum.KeyCode.Escape then
            activeBinding = nil
            if target == "hidegui" then
                if keybindButton then keybindButton.Text = SETTINGS.HIDE_KEYBIND and SETTINGS.HIDE_KEYBIND.Name or "None" end
            elseif kbChips[target] then
                kbChips[target].update()
            end
            return
        end
        activeBinding = nil
        if target == "hidegui" then
            SETTINGS.HIDE_KEYBIND = key
            if keybindButton then keybindButton.Text = key.Name end
        else
            KeyBinds[target] = key
            if kbChips[target] then kbChips[target].update() end
        end
        return
    end
    if KeyBinds.fly and key == KeyBinds.fly and movToggles.fly then
        movToggles.fly(not Movement.fly)
    end
    if KeyBinds.noclip and key == KeyBinds.noclip and movToggles.noclip then
        movToggles.noclip(not Movement.noClip)
    end
    if KeyBinds.tpnext and key == KeyBinds.tpnext and tpStepFn then
        tpStepFn(1)
    end
    if KeyBinds.tpprev and key == KeyBinds.tpprev and tpStepFn then
        tpStepFn(-1)
    end
    if SETTINGS.HIDE_KEYBIND and key == SETTINGS.HIDE_KEYBIND and screenGui then
        screenGui.Enabled = not screenGui.Enabled
    end
end)

