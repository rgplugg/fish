local function fuzzyMatch(query, target)
    query = string.lower(query)
    target = string.lower(target)
    if query == "" then return true end
    if string.find(target, query, 1, true) then return true end
    local i = 1
    for c = 1, #target do
        if string.sub(target, c, c) == string.sub(query, i, i) then
            i = i + 1
            if i > #query then return true end
        end
    end
    return false
end

