end

local Stats = {startTime = tick(), caught = 0, catchTimes = {}, lastRodName = nil}

local function isRodObject(obj)
    if not (obj:IsA("Tool") or obj:IsA("Model")) then return false end
    local ev = obj:FindFirstChild("events")
    if ev and ev:FindFirstChild("castAsync") then return true end
    return false
end

local function getBackpackRodName()
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return nil end
    for _, item in ipairs(backpack:GetChildren()) do
        if isRodObject(item) then return item.Name end
    end
    return nil
end

local function getEquippedRodName()
    local character = player.Character
    if not character then return nil end
    for _, item in ipairs(character:GetChildren()) do
        if isRodObject(item) then return item.Name end
    end
    return nil
end

local function getWorkspaceRodName()
    local folder = workspace:FindFirstChild(player.Name)
    if not folder then return nil end
    for _, child in ipairs(folder:GetChildren()) do
        if isRodObject(child) or child:FindFirstChild("bobber") then
            return child.Name
        end
    end
    return nil
end

local function getCurrentRodName()
    local name = getBackpackRodName() or getEquippedRodName() or getWorkspaceRodName()
    if name then Stats.lastRodName = name end
    return name or Stats.lastRodName
end

local function getRodProfile(rodName)
    if not rodName then return "default" end
    local n = string.lower(rodName)
    if string.find(n, "requiem") then return "requiem" end
    if string.find(n, "tryhard") then return "tryhard" end
    return "default"
end

