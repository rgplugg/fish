local function netChild(key)
    if not Net then return nil end
    return Net:FindFirstChild(key)
end

local function fireRE(key, ...)
    local args = table.pack(...)
    local r = netChild(key)
    if r and r:IsA("RemoteEvent") then
        pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end)
        return true
    end
    return false
end

local function invokeRF(key, ...)
