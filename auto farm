    end
end

local function captureFB()
    fbSaved = {props = {}, atmo = nil, effects = {}}
    fbSaved.props.Brightness = Lighting.Brightness
    fbSaved.props.ClockTime = Lighting.ClockTime
    fbSaved.props.GlobalShadows = Lighting.GlobalShadows
    fbSaved.props.Ambient = Lighting.Ambient
    fbSaved.props.OutdoorAmbient = Lighting.OutdoorAmbient
    fbSaved.props.FogEnd = Lighting.FogEnd
    fbSaved.props.FogStart = Lighting.FogStart
    fbSaved.props.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    fbSaved.props.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then
        fbSaved.atmo = {obj = atmo, Density = atmo.Density, Glare = atmo.Glare, Haze = atmo.Haze, Offset = atmo.Offset}
    end
    for _, eff in ipairs(Lighting:GetChildren()) do
        if eff:IsA("ColorCorrectionEffect") then
            fbSaved.effects[eff] = {Brightness = eff.Brightness, Contrast = eff.Contrast, Saturation = eff.Saturation, TintColor = eff.TintColor}
        elseif eff:IsA("SunRaysEffect") then
            fbSaved.effects[eff] = {Intensity = eff.Intensity}
        elseif eff:IsA("BloomEffect") then
            fbSaved.effects[eff] = {Intensity = eff.Intensity}
        end
    end
end

local function forceFB()
    Lighting.Brightness = 2.5
    Lighting.ClockTime = 14
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(178, 178, 178)
    Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
    Lighting.FogEnd = 1000000
    Lighting.FogStart = 1000000
    Lighting.EnvironmentDiffuseScale = 1
    Lighting.EnvironmentSpecularScale = 1
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then
        atmo.Density = 0
        atmo.Glare = 0
        atmo.Haze = 0
        atmo.Offset = 0
    end
    for _, eff in ipairs(Lighting:GetChildren()) do
        if eff:IsA("ColorCorrectionEffect") then
            eff.Brightness = 0
            eff.Contrast = 0
            eff.Saturation = 0
            eff.TintColor = Color3.new(1, 1, 1)
        elseif eff:IsA("SunRaysEffect") then
            eff.Intensity = 0
        end
    end
end

local function restoreFB()
    if not fbSaved then return end
    for k, v in pairs(fbSaved.props) do
        Lighting[k] = v
    end
    if fbSaved.atmo and fbSaved.atmo.obj and fbSaved.atmo.obj.Parent then
        local a = fbSaved.atmo
        a.obj.Density = a.Density
        a.obj.Glare = a.Glare
        a.obj.Haze = a.Haze
        a.obj.Offset = a.Offset
    end
    for eff, props in pairs(fbSaved.effects) do
        if eff.Parent then
            for k, v in pairs(props) do
                eff[k] = v
            end
        end
    end
    fbSaved = nil
end

local function setFullBright(on)
    Movement.fullBright = on
    if on then
        if not fbSaved then captureFB() end
        if not fbBound then
            fbBound = true
            RunService:BindToRenderStep("AutoFishFullBright", Enum.RenderPriority.Last.Value, function()
                if Movement.fullBright then
                    forceFB()
                end
            end)
        end
        forceFB()
    else
        if fbBound then
            RunService:UnbindFromRenderStep("AutoFishFullBright")
            fbBound = false
        end
        restoreFB()
    end
end

