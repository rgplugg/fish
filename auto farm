                HumanSimState.wasEnabled = false
                HumanSimState.active = false
                HumanSimState.blockUntil = 0
                HumanSimState.nextAfkAt = 0
            end
            continue
        end
        if not HumanSimState.wasEnabled then
            HumanSimState.wasEnabled = true
            if HumanSimState.nextAfkAt == 0 then
                HumanSimState.nextAfkAt = tick() + math.random(300, 900)
            end
        end
        if not HumanSimState.active and HumanSimState.nextAfkAt > 0 and tick() >= HumanSimState.nextAfkAt then
            local minV = SETTINGS.AFK_ROTATE_MIN
            local maxV = SETTINGS.AFK_ROTATE_MAX
            local duration = 0
            if maxV > 0 then
                if minV == maxV then
                    duration = minV
                else
                    duration = math.random(minV, maxV)
                end
            end
            if duration > 0 then
                HumanSimState.active = true
                HumanSimState.blockUntil = tick() + duration
                local lookStart = tick()
                while tick() - lookStart < duration do
                    if not running or not SETTINGS.SIMULATE_HUMAN then break end
                    local lookKey = math.random(0, 1) == 1 and Enum.KeyCode.Left or Enum.KeyCode.Right
                    local holdDuration = getHumanDelay(0.4, 1.8, 0.1)
                    pcall(function() VirtualInputManager:SendKeyEvent(true, lookKey, false, game) end)
                    task.wait(holdDuration)
                    pcall(function() VirtualInputManager:SendKeyEvent(false, lookKey, false, game) end)
                    task.wait(getHumanDelay(1.0, 3.5, 0.1))
                end
                HumanSimState.active = false
                HumanSimState.blockUntil = 0
            end
            HumanSimState.nextAfkAt = tick() + math.random(300, 900)
            resetFatigue()
        end
    end
end)

