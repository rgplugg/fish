        if not autoTP.active then return end
        local nxt = autoTP.index + 1
        if nxt > #TELEPORT_POINTS then
            stopAutoTP()
            return
        end
        autoTP.index = nxt
        selectRow(nxt)
        updateAutoTPSub()
        startFlight(nxt, TELEPORT_POINTS[nxt].pos)
    end

