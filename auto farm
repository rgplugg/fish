task.spawn(function()
    local SAFETY_MARGIN = 0.85
    local SLOW_SPEED = 1.5
    local TAP_CYCLE_NEAR = 0.22
    local TAP_CYCLE_FAR = 0.15
    local lastPlayerCenter = 0
    local smoothedVelocity = 0
    local prevVelocity = 0
    local aPress = 0.6
    local aRel = 0.6
    local tapTimer = 0
    local approachMargin = SAFETY_MARGIN
    local lastIterTime = 0
    local lastFishCenter = 0
    local smoothedFishV = 0
    local lastFishVRaw = 0
    local smoothedFishA = 0
    local lastSwitchAt = 0
    local lastProfile = "default"

    local function resetController()
        Controller.forceRelease()
        tapTimer = 0
        lastPlayerCenter = 0
        smoothedVelocity = 0
        prevVelocity = 0
        lastFishCenter = 0
        smoothedFishV = 0
        lastFishVRaw = 0
        smoothedFishA = 0
        lastSwitchAt = 0
        lastIterTime = 0
    end

    while running do
        if not SETTINGS.AUTO_REEL then
            resetController()
            task.wait(1)
            continue
        end
        local bar, fish, playerbar = getReelElements()
        if not bar or not fish or not playerbar then
            resetController()
            task.wait(0.2)
            continue
        end
        local profile = getRodProfile(getEquippedRodName() or Stats.lastRodName)
        if profile ~= lastProfile then
            lastProfile = profile
            resetController()
        end
        local checkInterval = SETTINGS.REEL_CHECK_INTERVAL
        local velOld, velNew = 0.6, 0.4
        local fishVOld, fishVNew = 0.65, 0.35
        local adaptOld, adaptNew = 0.92, 0.08
        local lookahead = TRYHARD_LOOKAHEAD
        local deadzone = 1.0
        local hyst = 0.5
        local useAccel = false
        local tickScale = 1
        if profile == "tryhard" then
            checkInterval = SETTINGS.REEL_CHECK_INTERVAL * TRYHARD_CHECK_MULT
            tickScale = checkInterval / SETTINGS.REEL_CHECK_INTERVAL
            velOld, velNew = 0.5, 0.5
            fishVOld, fishVNew = 0.5, 0.5
            adaptOld, adaptNew = 0.85, 0.15
            deadzone = TRYHARD_DEADZONE
            hyst = TRYHARD_HYST
            useAccel = true
        end
        local nowT = tick()
        local dt = nowT - lastIterTime
        if lastIterTime == 0 or dt <= 0 or dt > 0.5 then dt = checkInterval end
        lastIterTime = nowT
        local playerWidth = playerbar.AbsoluteSize.X
        local playerLeft = playerbar.AbsolutePosition.X
        local playerCenter = playerLeft + (playerWidth / 2)
        local barLeft = bar.AbsolutePosition.X
        local barRight = barLeft + bar.AbsoluteSize.X
        local fishCenter = fish.AbsolutePosition.X + fish.AbsoluteSize.X / 2
        local fishV = 0
        if lastFishCenter ~= 0 then fishV = (fishCenter - lastFishCenter) / dt end
        lastFishCenter = fishCenter
        smoothedFishV = (smoothedFishV * fishVOld) + (fishV * fishVNew)
        smoothedFishV = math.clamp(smoothedFishV, -playerWidth * 3, playerWidth * 3)
        local fishA = 0
        if useAccel and lastFishVRaw ~= 0 then fishA = (fishV - lastFishVRaw) / dt end
        lastFishVRaw = fishV
        smoothedFishA = (smoothedFishA * 0.7) + (fishA * 0.3)
        smoothedFishA = math.clamp(smoothedFishA, -playerWidth * 8, playerWidth * 8)
        local rawV = 0
        if lastPlayerCenter ~= 0 then rawV = playerCenter - lastPlayerCenter end
        lastPlayerCenter = playerCenter
        smoothedVelocity = (smoothedVelocity * velOld) + (rawV * velNew)
        local dv = smoothedVelocity - prevVelocity
        prevVelocity = smoothedVelocity
        if gamepadHeld and dv > 0 then
            aPress = (aPress * adaptOld) + (dv * adaptNew)
        elseif not gamepadHeld and dv < 0 then
            aRel = (aRel * adaptOld) + (-dv * adaptNew)
        end
        aPress = math.clamp(aPress, 0.05, 5)
        aRel = math.clamp(aRel, 0.05, 5)
        local d = fishCenter - playerCenter
        local v = smoothedVelocity
        local absD = math.abs(d)
        local absV = math.abs(v)
        updateFatigue()
        HumanFactors.DriftPhase = HumanFactors.DriftPhase + 0.05
        if profile ~= "tryhard" then
            local driftAmplitude = 4 + (HumanFactors.CurrentFatigue * 12)
            local humanDrift = math.sin(HumanFactors.DriftPhase) * math.cos(HumanFactors.DriftPhase * 0.5) * driftAmplitude
            d = d + humanDrift
            local skipChance = math.clamp(HumanFactors.CurrentFatigue * 4, 1, 4)
            if math.random(1, 100) <= skipChance then
                task.wait(SETTINGS.REEL_CHECK_INTERVAL)
            end
        end
        local edgeMargin = math.max(5, playerWidth * SETTINGS.EDGE_HOLD_PERCENT)
        local tapZone = math.max(20, playerWidth * SETTINGS.TAP_ZONE_PERCENT)
        if profile == "tryhard" then tapZone = math.max(3, playerWidth * 0.05) end
        local fishDistToLeftEdge = fishCenter - barLeft
        local fishDistToRightEdge = barRight - fishCenter
        local canCenterAtRight = (playerLeft + playerWidth + absD) < barRight - edgeMargin
        local canCenterAtLeft = (playerLeft - absD) > barLeft + edgeMargin
        if fishDistToRightEdge < (playerWidth / 2 + edgeMargin) and not canCenterAtRight then
            if profile == "requiem" then
                if not gamepadHeld and (nowT - lastSwitchAt) >= REQUIEM_MIN_STATE then
                    Controller.pressGamepad()
                    lastSwitchAt = nowT
                end
            else
                if not gamepadHeld then Controller.pressGamepad() end
            end
            tapTimer = 0
        elseif fishDistToLeftEdge < (playerWidth / 2 + edgeMargin) and not canCenterAtLeft then
            if profile == "requiem" then
                if gamepadHeld and (nowT - lastSwitchAt) >= REQUIEM_MIN_STATE then
                    Controller.releaseGamepad()
                    lastSwitchAt = nowT
                end
            else
                if gamepadHeld then Controller.releaseGamepad() end
            end
            tapTimer = 0
        elseif profile == "requiem" then
            local sinceSwitch = nowT - lastSwitchAt
            local desiredPress
            if d > 1 then desiredPress = true
            elseif d < -1 then desiredPress = false
            else desiredPress = gamepadHeld end
            if gamepadHeld ~= desiredPress and sinceSwitch >= REQUIEM_MIN_STATE then
                if desiredPress then Controller.pressGamepad() else Controller.releaseGamepad() end
                lastSwitchAt = nowT
            elseif sinceSwitch >= REQUIEM_MAX_STATE then
                if gamepadHeld then Controller.releaseGamepad() else Controller.pressGamepad() end
                lastSwitchAt = nowT
            end
            tapTimer = 0
        elseif profile == "tryhard" then
            tapTimer = 0
            local halfFish = fish.AbsoluteSize.X / 2
            local target = fishCenter + smoothedFishV * lookahead
            if useAccel then target = target + 0.5 * smoothedFishA * lookahead * lookahead end
            target = math.clamp(target, barLeft + halfFish, barRight - halfFish)
            local dd = target - playerCenter
            local press
            if v >= 0 then
                local stopDist = (v * v) / (2 * aRel)
                press = stopDist < dd
            else
                local stopDist = (v * v) / (2 * aPress)
                press = stopDist >= -dd
            end
            if math.abs(dd) < deadzone and math.abs(v) < 0.6 * tickScale then
                if gamepadHeld then press = dd > -hyst else press = dd > hyst end
            end
            if press then
                if not gamepadHeld then Controller.pressGamepad() end
            else
                if gamepadHeld then Controller.releaseGamepad() end
            end
        elseif absD < tapZone and absV < SLOW_SPEED then
            local distanceFactor = absD / tapZone
            local cycleTime = TAP_CYCLE_NEAR - (TAP_CYCLE_NEAR - TAP_CYCLE_FAR) * distanceFactor
            cycleTime = cycleTime * (0.9 + math.random() * 0.2)
            local ratio = 0.5 + (d / tapZone) * 0.25
            ratio = math.clamp(ratio, 0.25, 0.75)
            tapTimer = tapTimer + checkInterval
            if gamepadHeld then
                if tapTimer >= cycleTime * ratio then Controller.releaseGamepad() end
            else
                if tapTimer >= cycleTime then
                    Controller.pressGamepad()
                    tapTimer = 0
                end
            end
        else
            tapTimer = 0
            if absV < 0.5 then approachMargin = SAFETY_MARGIN + (math.random(0, 10) / 100) end
            local press
            if v >= 0 then
                local stopDist = (v * v) / (2 * aRel)
                press = stopDist < (d * approachMargin)
            else
                local stopDist = (v * v) / (2 * aPress)
                press = stopDist >= (-d * approachMargin)
            end
            if press then
                if not gamepadHeld then Controller.pressGamepad() end
            else
                if gamepadHeld then Controller.releaseGamepad() end
            end
        end
        task.wait(checkInterval)
    end
    Controller.forceRelease()
end)

local function formatTime(sec)
    sec = math.floor(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function fmtRange(minV, maxV)
    if minV == maxV then return string.format("%g", minV) end
    return string.format("%g-%g", minV, maxV)
end

