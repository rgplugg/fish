local function stopWarningPulse()
    for _, tw in ipairs(pulseTweens) do pcall(function() tw:Cancel() end) end
    pulseTweens = {}
end

local function startWarningPulse()
    stopWarningPulse()
    if not warningPill or not warningPill.Parent or not warningVisible then return end
    local stroke = warningPill:FindFirstChild("WarnStroke")
    if not stroke then return end
    local info = TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    table.insert(pulseTweens, TweenService:Create(warningPill, info, {BackgroundColor3 = WARN_BG_BRIGHT}))
    table.insert(pulseTweens, TweenService:Create(stroke, info, {Color = WARN_STROKE_BRIGHT}))
    for _, tw in ipairs(pulseTweens) do tw:Play() end
end

local function checkSettingsForWarning()
    local risky = false
    if SETTINGS.CAST_HOLD_MIN == SETTINGS.CAST_HOLD_MAX then risky = true end
    if SETTINGS.CAST_IDLE_MIN == SETTINGS.CAST_IDLE_MAX then risky = true end
    if SETTINGS.SHAKE_CD_MIN == SETTINGS.SHAKE_CD_MAX then risky = true end
    return risky
end

local function updateWarningPill(shouldShow)
    warningActive = shouldShow
    if not warningPill or not warningPill.Parent then return end
    if shouldShow and not warningVisible then
        warningVisible = true
        stopWarningPulse()
        warningPill.Visible = true
        warningPill.BackgroundColor3 = WARN_BG_DARK
        warningPill.BackgroundTransparency = 1
        warningPill.Position = UDim2.new(0, S(230), 0.5, -S(14))
        local stroke = warningPill:FindFirstChild("WarnStroke")
        if stroke then stroke.Color = WARN_STROKE_DARK; stroke.Transparency = 1 end
        local ti = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(warningPill, ti, {BackgroundTransparency = 0.15, Position = UDim2.new(0, S(256), 0.5, -S(14))}):Play()
        if stroke then TweenService:Create(stroke, ti, {Transparency = 0.25}):Play() end
        for _, ch in ipairs(warningPill:GetDescendants()) do
            if ch:IsA("TextLabel") then
                ch.TextTransparency = 1
                TweenService:Create(ch, ti, {TextTransparency = 0}):Play()
            elseif ch:IsA("Frame") and ch.Name == "WarnIconBg" then
                ch.BackgroundTransparency = 1
                TweenService:Create(ch, ti, {BackgroundTransparency = 0}):Play()
            end
        end
        task.delay(0.45, function() if warningVisible then startWarningPulse() end end)
    elseif not shouldShow and warningVisible then
        warningVisible = false
        stopWarningPulse()
        warningPill.BackgroundColor3 = WARN_BG_DARK
        local stroke = warningPill:FindFirstChild("WarnStroke")
        if stroke then stroke.Color = WARN_STROKE_DARK end
        local ti = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local tweens = {}
        table.insert(tweens, TweenService:Create(warningPill, ti, {BackgroundTransparency = 1, Position = UDim2.new(0, S(230), 0.5, -S(14))}))
        if stroke then table.insert(tweens, TweenService:Create(stroke, ti, {Transparency = 1})) end
        for _, ch in ipairs(warningPill:GetDescendants()) do
            if ch:IsA("TextLabel") then table.insert(tweens, TweenService:Create(ch, ti, {TextTransparency = 1}))
            elseif ch:IsA("Frame") and ch.Name == "WarnIconBg" then table.insert(tweens, TweenService:Create(ch, ti, {BackgroundTransparency = 1})) end
        end
        for _, tw in ipairs(tweens) do tw:Play() end
        task.delay(0.38, function() if not warningVisible and warningPill and warningPill.Parent then warningPill.Visible = false end end)
    end
end

