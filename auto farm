    local r = netChild(key)
    if r and r:IsA("RemoteFunction") then
        local ok, res = pcall(function() return r:InvokeServer(table.unpack(args, 1, args.n)) end)
        if ok then return res end
    end
    return nil
end

local HumanFactors = {SessionStart = tick(), LastRestTime = tick(), FishesCaughtSinceRest = 0, CurrentFatigue = 0, DriftPhase = 0}
local HumanSimState = {active = false, blockUntil = 0, nextAfkAt = 0, wasEnabled = false}

local function updateFatigue()
    local timeSinceRest = tick() - HumanFactors.LastRestTime
    local timeFactor = math.clamp(timeSinceRest / 2400, 0, 1)
    local fishFactor = math.clamp(HumanFactors.FishesCaughtSinceRest / 60, 0, 1)
    HumanFactors.CurrentFatigue = math.clamp((timeFactor + fishFactor) / 2, 0, 1)
end

local function resetFatigue()
    HumanFactors.LastRestTime = tick()
    HumanFactors.FishesCaughtSinceRest = 0
    HumanFactors.CurrentFatigue = 0
end

local function randomGaussian(mean, stdDev)
    local u1 = math.random()
    local u2 = math.random()
    if u1 == 0 then u1 = 0.0001 end
    local randStdNormal = math.sqrt(-2.0 * math.log(u1)) * math.cos(2.0 * math.pi * u2)
    return mean + randStdNormal * stdDev
end

local function getHumanDelay(baseMin, baseMax, fatigueMultiplier)
    updateFatigue()
    local fatigueBonus = HumanFactors.CurrentFatigue * fatigueMultiplier
    local min = baseMin + fatigueBonus * 0.5
    local max = baseMax + fatigueBonus
    local mean = (min + max) / 2
    local stdDev = (max - min) / 6
    return math.clamp(randomGaussian(mean, stdDev), min, max)
end

local function getDelay(baseMin, baseMax, fatigueMultiplier)
    if baseMin == baseMax then return baseMin end
    updateFatigue()
    local fatigueBonus = HumanFactors.CurrentFatigue * (fatigueMultiplier or 0)
    local min = baseMin + fatigueBonus * 0.5
    local max = baseMax + fatigueBonus
    local mean = (min + max) / 2
    local stdDev = (max - min) / 6
    local result = randomGaussian(mean, stdDev)
    return math.clamp(result, baseMin, baseMax)
end

