local Movement = {infJump = false, fly = false, noClip = false, fullBright = false, walkSpeed = 16, jumpPower = 50, flySpeed = 60}
local flightState = {active = false, spotId = nil, target = nil, conn = nil, character = nil, hrp = nil, humanoid = nil, silent = false}
local onFlightUI = nil
local onFlightArrived = nil

local function applyDefaultCollision(character)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = (part == hrp)
        end
    end
end

local function applyNoCollision(character)
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function isFreeSpace(character, cf)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.MaxParts = 1
    local found = workspace:GetPartBoundsInBox(cf, Vector3.new(2, 2, 2), params)
    return #found == 0
end

local function restoreDefaultsAsync(character)
    task.spawn(function()
        local tries = 0
        while tries < 20 do
            tries = tries + 1
            if not character or not character.Parent then return end
            if Movement.noClip then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if isFreeSpace(character, hrp.CFrame) then
                applyDefaultCollision(character)
                return
            end
            task.wait(0.4)
        end
        if not Movement.noClip then
            applyDefaultCollision(character)
        end
    end)
end

local function stopFlightLoop()
    if flightState.conn then
        flightState.conn:Disconnect()
        flightState.conn = nil
    end
end

local function cancelFlight()
    stopFlightLoop()
    local character = flightState.character
    local humanoid = flightState.humanoid
    local hrp = flightState.hrp
    if hrp and hrp.Parent then hrp.Anchored = false end
    if humanoid and humanoid.Parent then humanoid.PlatformStand = false end
    if character and character.Parent then
        restoreDefaultsAsync(character)
    end
    flightState.active = false
    flightState.spotId = nil
    flightState.target = nil
    flightState.silent = false
    if onFlightUI then onFlightUI(nil) end
end

local function startFlight(spotId, target)
    if not running then return false end
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return false end
    stopFlightLoop()
    local silent = (spotId == -1)
    flightState.active = true
    flightState.spotId = spotId
    flightState.target = target
    flightState.character = character
    flightState.hrp = hrp
    flightState.humanoid = humanoid
    flightState.silent = silent
    humanoid.PlatformStand = true
    applyNoCollision(character)
    hrp.Anchored = true
    if not silent and onFlightUI then onFlightUI("flying") end
    flightState.conn = RunService.Heartbeat:Connect(function(dt)
        if not flightState.active then return end
        if not hrp.Parent or not character.Parent then
            stopFlightLoop()
            flightState.active = false
            flightState.spotId = nil
            flightState.target = nil
            flightState.silent = false
            return
        end
        dt = math.min(dt, 0.1)
        local current = hrp.Position
        local delta = target - current
        local dist = delta.Magnitude
        local step = (SETTINGS.TP_SPEED or 500) * dt
        if step >= dist then
            hrp.CFrame = CFrame.new(target)
            stopFlightLoop()
            hrp.Anchored = false
            humanoid.PlatformStand = false
            flightState.active = false
            flightState.spotId = nil
            flightState.target = nil
            local wasSilent = flightState.silent
            flightState.silent = false
            restoreDefaultsAsync(character)
            if not wasSilent then
                if onFlightUI then onFlightUI(nil) end
                if onFlightArrived then onFlightArrived() end
            end
        else
            hrp.CFrame = CFrame.new(current + delta.Unit * step)
        end
    end)
    return true
end

