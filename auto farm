        local ti = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(chevronImg, ti, {Rotation = state and CHEV_ROT_EXPANDED or CHEV_ROT_COLLAPSED}):Play()
        local h = tpOpenHeight()
        if state then
            tpInner.Size = UDim2.new(1, 0, 0, h)
            tpBody.Visible = true
            if animate then
                tpInner.Position = UDim2.new(0, 0, 0, -h)
                TweenService:Create(tpBody, ti, {Size = UDim2.new(1, 0, 0, h)}):Play()
                TweenService:Create(tpInner, ti, {Position = UDim2.new(0, 0, 0, 0)}):Play()
            else
                tpBody.Size = UDim2.new(1, 0, 0, h)
                tpInner.Position = UDim2.new(0, 0, 0, 0)
            end
        else
            local cur = tpInner.Size.Y.Offset
            if animate then
                TweenService:Create(tpBody, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                TweenService:Create(tpInner, ti, {Position = UDim2.new(0, 0, 0, -cur)}):Play()
                task.delay(0.34, function()
                    if not tpExpanded then tpBody.Visible = false end
                end)
            else
                tpBody.Size = UDim2.new(1, 0, 0, 0)
                tpInner.Position = UDim2.new(0, 0, 0, -cur)
                tpBody.Visible = false
            end
        end
    end

    movHeaderBtn.MouseButton1Click:Connect(function() setMovExpanded(not movExpanded, true) end)
    movChevronBtn.MouseButton1Click:Connect(function() setMovExpanded(not movExpanded, true) end)
    headerBtn.MouseButton1Click:Connect(function() setTpExpanded(not tpExpanded, true) end)
    chevronBtn.MouseButton1Click:Connect(function() setTpExpanded(not tpExpanded, true) end)
    setMovExpanded(false, false)
    setTpExpanded(false, false)
end

