        if newId == currentPanel then return end
        local oldIdx, newIdx = 1, 1
        for i, v in ipairs(TAB_ORDER) do
            if v == currentPanel then oldIdx = i end
            if v == newId then newIdx = i end
        end
        local fromRight = newIdx > oldIdx
        local oldPanel = tabPanels[currentPanel]
        local newPanel = tabPanels[newId]
        if not newPanel then return end
        local ti = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        newPanel.Visible = true
        newPanel.Position = UDim2.new(fromRight and 1 or -1, 0, 0, 0)
        TweenService:Create(newPanel, ti, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        if oldPanel then
            TweenService:Create(oldPanel, ti, {Position = UDim2.new(fromRight and -1 or 1, 0, 0, 0)}):Play()
            local capOld = oldPanel
            local capNew = newId
