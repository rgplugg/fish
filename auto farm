        if state then
            movBody.Visible = true
            if animate then
                movInner.Position = UDim2.new(0, 0, 0, -MOV_OPEN_H)
                TweenService:Create(movBody, ti, {Size = UDim2.new(1, 0, 0, MOV_OPEN_H)}):Play()
                TweenService:Create(movInner, ti, {Position = UDim2.new(0, 0, 0, 0)}):Play()
            else
                movBody.Size = UDim2.new(1, 0, 0, MOV_OPEN_H)
                movInner.Position = UDim2.new(0, 0, 0, 0)
            end
        else
            if animate then
                TweenService:Create(movBody, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                TweenService:Create(movInner, ti, {Position = UDim2.new(0, 0, 0, -MOV_OPEN_H)}):Play()
                task.delay(0.34, function()
                    if not movExpanded then movBody.Visible = false end
                end)
            else
                movBody.Size = UDim2.new(1, 0, 0, 0)
