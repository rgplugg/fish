local Controller = {}
local gamepadHeld = false

function Controller.pressGamepad()
    if not running or gamepadHeld then return end
    pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.ButtonA, false, game) end)
    gamepadHeld = true
end

function Controller.releaseGamepad()
    if not gamepadHeld then return end
    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonA, false, game) end)
    gamepadHeld = false
end

function Controller.forceRelease()
    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonA, false, game) end)
    gamepadHeld = false
end

function Controller.clickGamepad()
    if not running then return false end
    local success = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.ButtonA, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonA, false, game)
    end)
    return success
end

local function findRod()
    local character = player.Character
    if character then
        for _, child in pairs(character:GetChildren()) do
            if (child:IsA("Tool") or child:IsA("Model")) and child:FindFirstChild("events") and child.events:FindFirstChild("castAsync") then
                return child
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, child in pairs(backpack:GetChildren()) do
            if (child:IsA("Tool") or child:IsA("Model")) and child:FindFirstChild("events") and child.events:FindFirstChild("castAsync") then
                return child
            end
        end
    end
    return nil
end

local function getShakeButton()
    local shakeui = playerGui:FindFirstChild("shakeui")
    if not shakeui or not shakeui.Enabled then return nil end
    local safezone = shakeui:FindFirstChild("safezone")
    if not safezone or not safezone.Visible then return nil end
    local default = safezone:FindFirstChild("default")
    if default and default:IsA("ImageButton") and default.Visible then return default end
    return nil
end

local function getReelElements()
    local reel = playerGui:FindFirstChild("reel")
    if not reel or not reel.Enabled then return nil end
    local bar = reel:FindFirstChild("bar")
    if not bar or not bar.Visible then return nil end
    local fish = bar:FindFirstChild("fish")
    local playerbar = bar:FindFirstChild("playerbar")
    if not fish or not playerbar or not fish.Visible or not playerbar.Visible then return nil end
    return bar, fish, playerbar
end

-- 1. AUTO EQUIP
task.spawn(function()
    while running do
        if SETTINGS.AUTO_EQUIP then
            local character = player.Character or player.CharacterAdded:Wait()
            local humanoid = character:WaitForChild("Humanoid")
            local backpack = player:WaitForChild("Backpack")
            
            local targetRod = nil

            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") and string.find(string.lower(item.Name), "rod") then
                    targetRod = nil
                    break
                end
            end

            if not targetRod then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and string.find(string.lower(item.Name), "rod") then
                        targetRod = item
                        break
                    end
                end
            end

            if targetRod then
                pcall(function()
                    humanoid:EquipTool(targetRod)
                end)
                task.wait(0.5)
            end
        end
        task.wait(0.5)
    end
end)

