-- 3. AUTO CAST (ОБЫЧНЫЕ КЛИКИ ЛКМ - САМЫЙ НАДЕЖНЫЙ СПОСОБ)
task.spawn(function()
    while running do
        if not SETTINGS.AUTO_CAST then
            task.wait(1)
            continue
        end

        local character = player.Character
        if not character then 
            task.wait(1) 
            continue 
        end

        -- Находим удочку в персонаже
        local rodInChar = nil
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "rod") then
                rodInChar = item
                break
            end
        end

        if not rodInChar then
            task.wait(1)
            continue
        end

        -- Если идет мини-игра или поклёвка — заброс не трогаем
        local isReeling = playerGui:FindFirstChild("reel") and playerGui.reel.Enabled
        local isShaking = playerGui:FindFirstChild("shakeui") and playerGui.shakeui.Enabled
        
        if isReeling or isShaking then
            task.wait(1)
            continue
        end

        local rodName = rodInChar.Name
        local playerFolder = workspace:FindFirstChild(player.Name)
        local hasBobber = false

        if playerFolder then
            local rodModel = playerFolder:FindFirstChild(rodName)
            if rodModel and rodModel:FindFirstChild("bobber") then
                hasBobber = true
            end
        end

        -- Если поплавка нет в воде — делаем обычный клик ЛКМ
        if not hasBobber then
            task.wait(0.5) -- Небольшая задержка для предотвращения спама
            
            -- Вычисляем случайное время удержания замаха
            local holdTime = SETTINGS.CAST_HOLD_MIN + math.random() * (SETTINGS.CAST_HOLD_MAX - SETTINGS.CAST_HOLD_MIN)
            
            -- Эмуляция обычного зажатия ЛКМ (работает в 99% эксплойтов)
            mouse1press()
            task.wait(holdTime)
            mouse1release()
            
            task.wait(1.0) -- Ждем появления боббера
            
            local bobberExists = true
            local waitStart = tick()
            
            -- Ожидаем поклевку, проверяя наличие боббера
            while running and bobberExists do
                task.wait(0.5)
                
                if playerGui:FindFirstChild("reel") and playerGui.reel.Enabled then break end
                if playerGui:FindFirstChild("shakeui") and playerGui.shakeui.Enabled then break end
                if (tick() - waitStart) > 25 then break end -- Сейв-таймаут
                
                local currentPlayerFolder = workspace:FindFirstChild(player.Name)
                bobberExists = false 
                
                if currentPlayerFolder then
                    local currentRodModel = currentPlayerFolder:FindFirstChild(rodName)
                    if currentRodModel and currentRodModel:FindFirstChild("bobber") then
                        bobberExists = true 
                    end
                end
            end
            
            task.wait(0.5)
        else
            task.wait(0.5)
        end
    end
end)

-- 4. AUTO REEL
task.spawn(function()
    local tapTimer = 0
    local lastFishPos = 0
    local fishVelocity = 0
    
    while running do
        if not SETTINGS.AUTO_REEL then
            Controller.forceRelease()
            tapTimer = 0
            lastFishPos = 0
            fishVelocity = 0
            task.wait(1)
            continue
        end

        local bar, fish, playerbar = getReelElements()
        
        if not bar or not fish or not playerbar then
            Controller.forceRelease()
            tapTimer = 0
            lastFishPos = 0
            fishVelocity = 0
            task.wait(0.2)
            continue
        end
        
        local currentFishPos = fish.AbsolutePosition.X + fish.AbsoluteSize.X / 2
        local playerLeft = playerbar.AbsolutePosition.X
        local playerWidth = playerbar.AbsoluteSize.X
        local playerCenter = playerLeft + (playerWidth / 2)
        
        local barLeft = bar.AbsolutePosition.X
        local barRight = barLeft + bar.AbsoluteSize.X
        
        local rawVelocity = currentFishPos - lastFishPos
        fishVelocity = (fishVelocity * 0.7) + (rawVelocity * 0.3)
        lastFishPos = currentFishPos
        
        local predictedFishCenter = currentFishPos + (fishVelocity * 0.4)
        
        local error = predictedFishCenter - playerCenter
        local absError = math.abs(error)
        
        local fishDistToLeftEdge = currentFishPos - barLeft
        local fishDistToRightEdge = barRight - currentFishPos
        
        local canCenterAtRight = (playerLeft + playerWidth + absError) < barRight - SETTINGS.EDGE_HOLD_MARGIN
        local canCenterAtLeft = (playerLeft - absError) > barLeft + SETTINGS.EDGE_HOLD_MARGIN
        
        local dynamicTapZone = math.clamp(playerWidth * 0.45, 40, SETTINGS.TAP_ZONE)
        
        if fishDistToRightEdge < (playerWidth / 2 + SETTINGS.EDGE_HOLD_MARGIN) and not canCenterAtRight then
            if not gamepadHeld then Controller.pressGamepad() end
            tapTimer = 0
        elseif fishDistToLeftEdge < (playerWidth / 2 + SETTINGS.EDGE_HOLD_MARGIN) and not canCenterAtLeft then
            if gamepadHeld then Controller.releaseGamepad() end
            tapTimer = 0
        elseif absError < dynamicTapZone then
            local ratio = 0.5 + (error / dynamicTapZone) * 0.35
            
            if absError < 12 then
                ratio = 0.5
            end
            
            ratio = math.clamp(ratio, SETTINGS.TAP_RATIO_MIN, SETTINGS.TAP_RATIO_MAX)
            
            tapTimer = tapTimer + SETTINGS.REEL_CHECK_INTERVAL
            
            if gamepadHeld then
                if tapTimer >= SETTINGS.TAP_CYCLE * ratio then
                    Controller.releaseGamepad()
                end
            else
                if tapTimer >= SETTINGS.TAP_CYCLE then
                    Controller.pressGamepad()
                    tapTimer = 0
                end
            end
        else
            tapTimer = 0
            if error > 0 then
                if absError > dynamicTapZone * 1.5 then
                    if not gamepadHeld then Controller.pressGamepad() end
                else
                    if gamepadHeld then Controller.releaseGamepad() else Controller.pressGamepad() end
                end
            else
                if gamepadHeld then Controller.releaseGamepad() end
            end
        end
        
        task.wait(SETTINGS.REEL_CHECK_INTERVAL)
    end
    
    Controller.forceRelease()
end)

