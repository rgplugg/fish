        if enterPressed then
            local text = castBox.Text:match("^%s*(.-)%s*$")
            
            if text:find("-") then
                local min, max = text:match("(%d+%.?%d*)%-(%d+%.?%d*)")
                if min and max then
                    SETTINGS.CAST_HOLD_MIN = tonumber(min)
                    SETTINGS.CAST_HOLD_MAX = tonumber(max)
                    warningLabel.Visible = false
                end
            else
                local val = tonumber(text)
                if val and val >= 0.2 and val <= 5 then
                    SETTINGS.CAST_HOLD_MIN = val
                    SETTINGS.CAST_HOLD_MAX = val
                    warningLabel.Visible = true
                else
                    warningLabel.Visible = false
                end
            end
        end
    end)
    
    local function switchView(toView)
        if toView == currentView then return end
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        if toView == "settings" then
            settingsView.Visible = true
            settingsView.Position = UDim2.new(1, 0, 0, 0)
            TweenService:Create(settingsView, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
            TweenService:Create(automationView, tweenInfo, {Position = UDim2.new(-1, 0, 0, 0)}):Play()
            task.delay(0.3, function()
                if currentView == "settings" then
                    automationView.Visible = false
                end
            end)
            currentView = "settings"
        else
            automationView.Visible = true
            automationView.Position = UDim2.new(-1, 0, 0, 0)
            TweenService:Create(automationView, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
            TweenService:Create(settingsView, tweenInfo, {Position = UDim2.new(1, 0, 0, 0)}):Play()
            task.delay(0.3, function()
                if currentView == "automation" then
                    settingsView.Visible = false
                end
            end)
            currentView = "automation"
        end
    end
    
    settingsButton.MouseButton1Click:Connect(function()
